# Copy this file to newsproject/.env and replace each placeholder locally.
DJANGO_SECRET_KEY=replace-with-a-long-random-value
APPROVAL_CALLBACK_TOKEN=replace-with-a-long-random-value

# Use mysql for MariaDB. Use sqlite for a local SQLite-only setup.
DB_ENGINE=mysql
DB_NAME=capstone_news
DB_USER=capstone_user
DB_PASSWORD=replace-with-your-mariadb-password
DB_HOST=127.0.0.1
DB_PORT=3306
